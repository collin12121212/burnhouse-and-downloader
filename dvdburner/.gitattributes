# Shell scripts must keep LF line endings. A CRLF in bundle-deps.sh produces a
# "bad interpreter" error on macOS, which is a confusing way to discover that
# Git rewrote a file during checkout.
*.sh text eol=lf

# Windows batch files must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets should never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.dmg binary
*.icns binary
